# Copy these names into GitHub → Settings → Secrets and variables → Actions → Variables.
# Missing or false = off. Values other than true/false/yes/no/on/off/1/0 fail the run,
# even when the platform's master switch is off.

# --- iOS (ios-v* tags; .github/workflows/ios-release.yml) ---
# Master switch: when off, no iOS store operation runs (the GitHub Release is still created).
IOS_RELEASE_AUTOMATION=false
# Create the tag's App Store version in App Store Connect when it is missing (before
# the preflight; tag runs only). Leaves an existing version alone; refuses when another
# version is still on its way to the store or the tag is not newer than every existing version.
IOS_CREATE_VERSION=false
# Build, sign and upload the binary to App Store Connect, then wait for processing.
IOS_UPLOAD_BUILD=false
# App name, subtitle, description, keywords, promotional text, privacy/marketing/support URLs
# (store/metadata/ios/<locale>/).
IOS_UPLOAD_LISTING=false
# What's New for the version (the tag's RELEASE_NOTES.md section).
IOS_UPLOAD_WHATS_NEW=false
# iPhone 6.7", iPad 13", iPhone Duo and Apple Watch screenshots, staged as RGB
# (store/app-store/screenshots/iphone, ipad, and iphone-duo and watch when they have frames).
IOS_UPLOAD_SCREENSHOTS=false
# Product page header and search results images from store/creative/ios. Each new
# image is uploaded to the Asset Library once and sent to App Review in a submission
# of its own (never the version's); once Apple approves it, a run places it on the
# version while the version can be edited.
IOS_UPLOAD_CREATIVE_ASSETS=false
# Select this run's processed build and submit it, and Ready-to-Submit catalog products,
# for App Review (needs IOS_UPLOAD_BUILD).
# The listing, What's New, screenshot, creative asset and review switches need the App
# Store version to exist: turn on IOS_CREATE_VERSION or create it in App Store Connect
# first. A read-only preflight checks it before anything is built.
IOS_SUBMIT_REVIEW=false
# true = release automatically after approval; false = you release it by hand (needs IOS_SUBMIT_REVIEW).
IOS_PUBLIC_RELEASE=false
# Build readiness polling (defaults shown): poll every 10–600 seconds, wait 10–300 minutes
# in total from the start of the upload.
IOS_BUILD_POLL_SECONDS=30
IOS_BUILD_WAIT_MINUTES=120

# --- Android (android-v* tags; .github/workflows/android-release.yml) ---
# Master switch: when off, an android-v* tag builds and releases nothing.
# When on, the tag builds the signed AAB/APK and creates the GitHub Release.
ANDROID_RELEASE_AUTOMATION=false
# Play title, short and full description (store/metadata/play/<locale>/).
ANDROID_UPLOAD_LISTING=false
# English What's New on this run's Play release (needs a track below).
ANDROID_UPLOAD_WHATS_NEW=false
# Play phone screenshots (store/google-play/screenshots/phone).
ANDROID_UPLOAD_SCREENSHOTS=false
# Upload this build to Play internal testing.
ANDROID_INTERNAL_TESTING=false
# Upload this build to Play closed testing (the alpha track).
ANDROID_CLOSED_TESTING=false
# Upload this build to Play production, live. Independent of the testing tracks.
# Google has not granted Verceltics production access yet, so Play rejects it until then.
ANDROID_PRODUCTION_ROLLOUT=false
