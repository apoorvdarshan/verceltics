# GitHub repository Variables. Every switch starts OFF.
STORE_IOS_RELEASE_ENABLED=false
STORE_UPLOAD_LISTING=false
STORE_UPLOAD_SCREENSHOTS=false
STORE_SUBMIT_IOS_REVIEW=false

# Android (android-v* tags). Builds, signs, and creates a GitHub prerelease when "true".
STORE_ANDROID_RELEASE_ENABLED=false
# none, internal, or closed. Production is rejected until Google allows a production release.
STORE_PLAY_TRACK=none
# Sends the tag's reviewed notes as Play What's New with the testing upload.
STORE_UPLOAD_WHATS_NEW=false
