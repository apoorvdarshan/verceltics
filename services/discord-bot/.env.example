# Copy outside the repository, for example to ~/.config/verceltics/discord.env.
# Load with node --env-file=/absolute/path/to/discord.env.
# Never commit populated credentials.
DISCORD_APPLICATION_ID=1555610391508426783
DISCORD_PUBLIC_KEY=7123e977c17d09e99094c9444e59bba63ea6d4a64cacc69618b9776c9324fec8
DISCORD_GUILD_ID=
DISCORD_ANNOUNCEMENTS_CHANNEL_ID=
DISCORD_IOS_BUG_CHANNEL_ID=
DISCORD_ANDROID_BUG_CHANNEL_ID=
DISCORD_GEMINI_MODEL=gemini-3.5-flash-lite

# Secrets. Command registration needs only DISCORD_BOT_TOKEN.
DISCORD_BOT_TOKEN=
DISCORD_GEMINI_API_KEY=
# Optional dedicated issue token; the Worker falls back to GITHUB_TOKEN.
DISCORD_GITHUB_TOKEN=
GITHUB_TOKEN=
